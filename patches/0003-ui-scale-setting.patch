+
+/*!	Sizes all four fonts for \a scale (0 for automatic). Everything that
+	scales with the font size - controls, window borders, icons, the cursor -
+	follows, in applications started from now on.
+*/
+void
+FontView::_SetUIScale(float scale)
+{
+	const bool automatic = scale <= 0.0f;
+	if (automatic)
+		scale = automatic_ui_scale();
+
+	const float size = roundf(kDefaultFontSize * scale);
+	fScaleSize = size;
+	fPlainView->SetSize(size);
+	fBoldView->SetSize(size);
+	fFixedView->SetSize(size);
+	fMenuView->SetSize(size);
+
+	set_ui_scale_automatic(automatic);
+	_MarkUIScale();
+}
+
+
+void
+FontView::_MarkUIScale()
+{
+	BMenuItem* marked = NULL;
+	if (ui_scale_is_automatic())
+		marked = fScaleMenu->ItemAt(0);
+	else {
+		const float size = fPlainView->CurrentSize();
+		for (int32 i = 0; BMenuItem* item = fScaleMenu->ItemAt(i); i++) {
+			float scale;
+			if (item->Message() != NULL
+				&& item->Message()->FindFloat("scale", &scale) == B_OK
+				&& scale > 0.0f
+				&& roundf(kDefaultFontSize * scale) == size) {
+				marked = item;
+				break;
+			}
+		}
+	}
+
+	if (marked != NULL)
+		marked->SetMarked(true);
+	else {
+		if (BMenuItem* item = fScaleMenu->FindMarked())
+			item->SetMarked(false);
+		fScaleField->MenuItem()->SetLabel(B_TRANSLATE("Custom"));
+	}
+}
